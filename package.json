{
  "name": "ghtrends-radar",
  "version": "0.15.0",
  "description": "Find open-source opportunities with GitHub supply and Google search demand. CLI, MCP and a beautiful opportunity radar.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "ghtrends": "dist/cli.js"
  },
  "files": [
    "dist",
    "web-dist",
    "README.md",
    "LICENSE",
    "README.zh-CN.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.node.json && vite build",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "commander": "^14.0.0",
    "express": "^5.1.0",
    "lucide-react": "^0.577.0",
    "openid-client": "^6.8.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4",
    "undici": "^7.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noahbenjamin1994/ghtrends-radar.git"
  },
  "homepage": "https://ghtrends.dev/radar",
  "bugs": {
    "url": "https://github.com/noahbenjamin1994/ghtrends-radar/issues"
  }
}
