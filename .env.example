PORT=3721
HOST=127.0.0.1
# May include a directory, e.g. https://example.com/radar
PUBLIC_URL=http://localhost:3721
GHTRENDS_DATA_DIR=./data
# Optional for GitHub requests. Prefer GitHub App credentials on hosted instances.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=
# Optional outbound proxy used by Google Trends on restricted networks.
GOOGLE_TRENDS_PROXY=
# Optional second fixed route in the same region; separate cookies and cooldown.
GOOGLE_TRENDS_PROXY_FALLBACK=
# Optional safe region label for the admin screen, e.g. US
GHTRENDS_TRENDS_PROXY_REGION=
# Optional server-side Decodo management API key for billed usage and balance.
DECODO_API_KEY=
# Web search reuses the residential proxies above. Direct: Google, then DuckDuckGo Lite.
# Modes: direct / api (managed Google only) / off.
GHTRENDS_SEARCH_MODE=direct
# Public discovery: reuse SERP slots for communities/marketplaces; software adds one 6s HN request.
GHTRENDS_PUBLIC_SOURCES=1
# Read a bounded sample of original pages and public discussion/license sources.
GHTRENDS_SOURCE_DOCUMENTS=1
# Docker bundles this Python runtime; source/npm installs need curl_cffi==0.16.3.
GHTRENDS_SEARCH_PYTHON=
# Optional dedicated search routes, otherwise GOOGLE_TRENDS_PROXY(_FALLBACK).
GOOGLE_SEARCH_PROXY=
GOOGLE_SEARCH_PROXY_FALLBACK=
# Optional managed API mode, with a separate service entitlement.
DECODO_SCRAPER_TOKEN=
# Set to true only on a dedicated trusted collection process.
GHTRENDS_COLLECTOR=false
# Optional AI, always server-side.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Keep reasoning for direction selection/review; extraction and writing use direct generation.
GHTRENDS_RESEARCH_THINKING=low
GHTRENDS_RESEARCH_REVIEW_THINKING=low
# Hosted: HTTPS public URL, Logto Traditional app callback /auth/callback.
GHTRENDS_HOSTED=0
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
# Hosted research credits shared by fresh scans, repo analysis and comparisons.
GHTRENDS_DAILY_SCANS=10
# Shared daily attempts budget, including returned credits. Per-user attempts = 3x credits.
GHTRENDS_DAILY_REQUESTS=200
# Comma-separated immutable Logto user IDs (sub), NEVER display names/usernames.
# Empty = no hosted administrators. Local mode without Logto uses workspace owner.
GHTRENDS_ADMIN_USER_IDS=
GHTRENDS_LOG_RETENTION_DAYS=30
# Optional USD per million tokens; set current provider rates yourself.
# Keys: model -> {input,cachedInput,output,offPeakMultiplier?}
# offPeakMultiplier follows DeepSeek's UTC peak schedule; omit for flat pricing.
# No configured rates = unknown cost. Estimates are not invoices.
GHTRENDS_LLM_PRICING_JSON=

# Focused research preview: private tasks and one lifetime hosted trial per account.
GHTRENDS_DEEP_RESEARCH=0
# Deep research: direct writing, low-effort semantic review (off for an explicit comparison).
GHTRENDS_DEEP_REVIEW_THINKING=low
# Daily new-task capacity; three attempts per account/day and per task.
GHTRENDS_DEEP_DAILY_REQUESTS=20

# Optional hosted account connection. Server-only; never use VITE_ variables.
# HTTPS origin or internal cluster service (e.g. http://nexus-app.nexus.svc:18081).
# Reads finite research-pack balances and records; task spending is enabled separately.
GHTRENDS_NEXUS_URL=
GHTRENDS_NEXUS_PROJECT_ID=ghtrends
GHTRENDS_NEXUS_PROJECT_KEY=
# Purchased-task admission (requires hosted mode, focused research and Nexus).
GHTRENDS_PAID_RESEARCH=0
# HTTPS cashier origin and Nexus research plan UUID; shown when paid research is enabled.
GHTRENDS_CASHIER_URL=
GHTRENDS_RESEARCH_PLAN_ID=
# Separate new-task capacity for purchased research; one active task per account.
GHTRENDS_PAID_DEEP_DAILY_REQUESTS=20
GHTRENDS_PAID_DEEP_DAILY_ATTEMPTS=10
